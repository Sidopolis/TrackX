<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TrackX - Real-Time Location Tracking</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script type="module" src="https://unpkg.com/@splinetool/viewer@0.9.506/build/spline-viewer.js"></script>
</head>
<body>
    <div class="intro-container">
        <div class="spline-container">
            <!-- Updated Spline scene URL with interactive Earth -->
            <spline-viewer 
                url="https://prod.spline.design/cCx7iMGDA90Khh10/scene.splinecode"
                loading-anim
                events-target="global">
            </spline-viewer>
        </div>
        <div class="content-overlay">
            <h1 class="logo">TrackX</h1>
            <p class="tagline">Experience real-time location tracking<br>with unprecedented precision</p>
            <button class="start-button">Start Tracking</button>
            <p class="interaction-hint">✨ Click and drag to rotate the Earth • Explore the 3D magic ✨</p>
            <p class="privacy-notice">Your privacy matters. Location data is only shared while the map is active.</p>
        </div>
    </div>
    
    <div id="map"></div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
    <script src="https://cdn.socket.io/4.7.5/socket.io.min.js"></script>
    <script src="/js/script.js"></script>
</body>
</html>